# Copy to .env.local. Public values only: these end up in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_API_URL=http://localhost:8000
# Error reports and feedback (Sentry, EU region); unset turns them off.
NEXT_PUBLIC_SENTRY_DSN=
# Build time only, to upload source maps (Vercel): an org auth token and the slugs.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Session replay (PostHog EU), only for people who opt in. The project key (phc_...), public.
NEXT_PUBLIC_POSTHOG_KEY=
# The phone app's link files (/.well-known/...): Apple Developer team id, and the Android signing
# keys' SHA-256 fingerprints (EAS and Google Play app signing, comma-separated). Unset: a 404.
# Production has ANDROID_CERT_SHA256 set (Play app signing 9A:2F:..., EAS upload key B0:16:...); both are
# public certificate fingerprints, shown in Play Console under Play app signing.
APPLE_TEAM_ID=
ANDROID_CERT_SHA256=
# The phone apps' store pages once they are live (the landing site reads the same two): the app's
# Apple ID from App Store Connect (digits), and 1 once the Google Play listing is public. Unset,
# nothing points to the stores.
NEXT_PUBLIC_APP_STORE_ID=
NEXT_PUBLIC_PLAY_STORE_LIVE=
