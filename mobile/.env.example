# Copy to mobile/.env.local for `npx expo start`. EXPO_PUBLIC_ values are built into the app, so
# only public values go here. EAS builds take the URLs from eas.json and the rest from EAS
# environment variables (`npx eas-cli env:create`).
# A local API from a phone: http://<your Mac's LAN address>:8000 (localhost is the phone itself).
EXPO_PUBLIC_API_URL=https://api.pantrila.com
EXPO_PUBLIC_SUPABASE_URL=https://tlnigvzkselebbtetibt.supabase.co
# The project's publishable key (sb_publishable_...), as on Vercel; needed from sign-in (PR 4).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google sign-in (docs/google-sign-in.md): the Web client id Supabase already uses, and the iOS
# client id made for com.pantrila.app. Without them the Google buttons are hidden.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_SENTRY_DSN=
