# Copy to .env and fill in. Never commit real values.

# OpenAI
OPENAI_API_KEY=
PANTRILA_MODEL=gpt-5.4-mini
PANTRILA_EMBED_MODEL=text-embedding-3-small

# USD per million tokens, used for cost reporting. Check current OpenAI pricing.
# gpt-5.4-mini prices below; change them if you change PANTRILA_MODEL.
PANTRILA_PRICE_INPUT_PER_MTOK=0.75
PANTRILA_PRICE_OUTPUT_PER_MTOK=4.50
PANTRILA_PRICE_EMBED_PER_MTOK=0.02

# Video import: speech-to-text model for a video's sound, priced per minute of audio
# (gpt-4o-mini-transcribe $0.003/min, gpt-4o-transcribe $0.006/min; check current pricing).
PANTRILA_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
PANTRILA_PRICE_TRANSCRIBE_PER_MIN=0.003

# Web search for a caption's dish when no Pantrila recipe matches (OpenAI's web search tool,
# billed per call). Unset, such imports report their cost as unknown. Check OpenAI's pricing
# page; published figures ranged from $10 to $50 per 1,000 calls when this was written.
# PANTRILA_PRICE_WEB_SEARCH_PER_CALL=0.025

# Reel audio from a link: when a post's caption (and any recipe site it links) gives no full
# recipe, a third-party service (Apify, one actor per platform; see post_media.ACTORS) finds the
# post's video so Pantrila can hear it, and reads TikTok captions. Off unless
# PANTRILA_MEDIA_SOURCE=apify and APIFY_TOKEN are set. PANTRILA_MEDIA_PLATFORMS narrows the
# platforms (default instagram,tiktok,facebook). Fees per run default to the actors' prices on
# 20 October 2026; override with PANTRILA_PRICE_MEDIA_INSTAGRAM / _TIKTOK / _FACEBOOK.
# Before the video, the same service reads a post's top 10 comments (post_media.COMMENT_ACTORS)
# for a recipe link by the post's own creator. Each comments run counts against
# PANTRILA_DAILY_REEL_FETCHES. Fees per comment (Apify FREE tier, 21 October 2026) can be
# overridden with PANTRILA_PRICE_COMMENT_INSTAGRAM / _TIKTOK / _FACEBOOK.
PANTRILA_MEDIA_SOURCE=off
APIFY_TOKEN=
PANTRILA_MEDIA_PLATFORMS=instagram,tiktok,facebook
PANTRILA_DAILY_REEL_FETCHES=10

# Recipe photos (pantrila photos generate, and cookbook photos in the API). Image model and its
# USD per million tokens: text input and image output.
PANTRILA_IMAGE_MODEL=gpt-image-2.5-flare
PANTRILA_PRICE_IMAGE_INPUT_PER_MTOK=5
PANTRILA_PRICE_IMAGE_OUTPUT_PER_MTOK=30

# Postgres 16 + pgvector (docker compose up -d db gives the local URL below)
DATABASE_URL=postgresql://pantrila:pantrila@localhost:5432/pantrila
# Separate database for DB tests; tests drop and recreate its tables.
PANTRILA_TEST_DATABASE_URL=

# Supabase. The API verifies sign-in tokens with the project's public keys (JWKS) from here.
SUPABASE_URL=https://tlnigvzkselebbtetibt.supabase.co
# Server side only: recipe photos in Supabase Storage and account deletion (Auth admin API).
# Unset turns photo generation and in-app account deletion off.
SUPABASE_SERVICE_ROLE_KEY=

# API (pantrila.api): allowed web origins, comma separated, and daily caps for the public demo
# (per user, and total spend across users; days start at midnight UTC).
PANTRILA_CORS_ORIGINS=http://localhost:3000
PANTRILA_DAILY_PLANS=5
PANTRILA_DAILY_CHATS=10
PANTRILA_DAILY_IMPORTS=20
PANTRILA_DAILY_PHOTOS=5
PANTRILA_DAILY_BUDGET_USD=2

# LangSmith tracing, datasets and experiments (optional; everything works with these unset)
LANGSMITH_API_KEY=
# EU accounts (eu.smith.langchain.com) need https://eu.api.smith.langchain.com; unset means US.
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=pantrila
LANGSMITH_TRACING=false

# Search embedding calls are metered too. Concurrent paid work reserves a conservative
# allowance, then reconciles actual cost. A reservation is not a provider billing ceiling.
PANTRILA_DAILY_SEARCHES=100
PANTRILA_RESERVE_PLAN_USD=0.50
PANTRILA_RESERVE_CHAT_USD=0.15
PANTRILA_RESERVE_IMPORT_USD=0.15
PANTRILA_RESERVE_PHOTO_USD=0.10
PANTRILA_RESERVE_SEARCH_USD=0.002
PANTRILA_RESERVE_REEL_USD=0.02

# Error reports (Sentry, EU region: the DSN host is ingest.de.sentry.io). Unset turns them off.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production       # default: production on Render, else development
# SENTRY_TRACES_SAMPLE_RATE=0.1       # share of requests traced for latency
