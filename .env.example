# Copy to .env and fill in. Never commit real values.

# OpenAI
OPENAI_API_KEY=
PANTRIO_MODEL=gpt-5.5
PANTRIO_EMBED_MODEL=text-embedding-3-small

# USD per million tokens, used for cost reporting. Check current OpenAI pricing.
PANTRIO_PRICE_INPUT_PER_MTOK=
PANTRIO_PRICE_OUTPUT_PER_MTOK=
PANTRIO_PRICE_EMBED_PER_MTOK=0.02

# Postgres 16 + pgvector (docker compose up -d db gives the local URL below)
DATABASE_URL=postgresql://pantrio:pantrio@localhost:5432/pantrio
# Separate database for DB tests; tests drop and recreate its tables.
PANTRIO_TEST_DATABASE_URL=

# Supabase (deploy only)
SUPABASE_SERVICE_ROLE_KEY=

# LangSmith tracing, datasets and experiments (optional; everything works with these unset)
LANGSMITH_API_KEY=
# EU accounts (eu.smith.langchain.com) need https://eu.api.smith.langchain.com; unset means US.
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=pantrio
LANGSMITH_TRACING=false
