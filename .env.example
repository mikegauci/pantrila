# Copy to .env and fill in. Never commit real values.

# OpenAI
OPENAI_API_KEY=
PANTRIO_MODEL=gpt-5.4-mini
PANTRIO_EMBED_MODEL=text-embedding-3-small

# USD per million tokens, used for cost reporting. Check current OpenAI pricing.
# gpt-5.4-mini prices below; change them if you change PANTRIO_MODEL.
PANTRIO_PRICE_INPUT_PER_MTOK=0.75
PANTRIO_PRICE_OUTPUT_PER_MTOK=4.50
PANTRIO_PRICE_EMBED_PER_MTOK=0.02

# Recipe photos (pantrio photos generate, and cookbook photos in the API). Image model and its
# USD per million tokens: text input and image output.
PANTRIO_IMAGE_MODEL=gpt-image-2.5-flare
PANTRIO_PRICE_IMAGE_INPUT_PER_MTOK=5
PANTRIO_PRICE_IMAGE_OUTPUT_PER_MTOK=30

# Postgres 16 + pgvector (docker compose up -d db gives the local URL below)
DATABASE_URL=postgresql://pantrio:pantrio@localhost:5432/pantrio
# Separate database for DB tests; tests drop and recreate its tables.
PANTRIO_TEST_DATABASE_URL=

# Supabase. The API verifies sign-in tokens with the project's public keys (JWKS) from here.
SUPABASE_URL=https://tlnigvzkselebbtetibt.supabase.co
# Server side only: uploads recipe photos to Supabase Storage. Unset turns photo generation off.
SUPABASE_SERVICE_ROLE_KEY=

# API (pantrio.api): allowed web origins, comma separated, and daily caps for the public demo
# (per user, and total spend across users; days start at midnight UTC).
PANTRIO_CORS_ORIGINS=http://localhost:3000
PANTRIO_DAILY_PLANS=5
PANTRIO_DAILY_CHATS=50
PANTRIO_DAILY_IMPORTS=20
PANTRIO_DAILY_PHOTOS=5
PANTRIO_DAILY_BUDGET_USD=2

# LangSmith tracing, datasets and experiments (optional; everything works with these unset)
LANGSMITH_API_KEY=
# EU accounts (eu.smith.langchain.com) need https://eu.api.smith.langchain.com; unset means US.
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=pantrio
LANGSMITH_TRACING=false

# Search embedding calls are metered too. Concurrent paid work reserves a conservative
# allowance, then reconciles actual cost. A reservation is not a provider billing ceiling.
PANTRIO_DAILY_SEARCHES=100
PANTRIO_RESERVE_PLAN_USD=0.50
PANTRIO_RESERVE_CHAT_USD=0.15
PANTRIO_RESERVE_IMPORT_USD=0.15
PANTRIO_RESERVE_PHOTO_USD=0.10
PANTRIO_RESERVE_SEARCH_USD=0.002
